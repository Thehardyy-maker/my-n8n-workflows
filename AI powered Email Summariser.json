        "jsCode": "// Get the text from Gemini\nconst aiText = $input.first().json.text;\n\n// Clean up the \"markdown\" (remove ```json and ```)\nconst cleanText = aiText.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// Convert text to real Data (JSON)\ntry {\n  const jsonData = JSON.parse(cleanText);\n  return {\n    summary: jsonData.summary,\n    reply_needed: jsonData.reply_needed,\n    suggested_reply: jsonData.suggested_reply\n  };\n} catch (error) {\n  return { error: \"AI returned bad data\", raw_text: aiText };\n}"
